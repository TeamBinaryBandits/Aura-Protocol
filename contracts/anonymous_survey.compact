// AURA - Privacy-Preserving Anonymous Feedback & Survey Protocol
// Compact smart contract for Midnight Network (Preview & Preprod)

pragma language_version >= 0.14.0;

import CompactStandardLibrary;

// ── Public ledger state (visible on-chain) ──────────────────────────────────
export ledger poll_id: Counter;
export ledger poll_title_hash: Bytes<32>;
export ledger active_network_id: Uint<8>;         // 1 = Preview, 2 = Preprod
export ledger total_ballots_cast: Counter;
// Public aggregate counters. Compact currently requires exported circuits to
// modify public ledger state; an observer can therefore see tally deltas. The
// privacy model documents this limitation and never promises secret ballots.
export ledger option_a_votes: Counter;
export ledger option_b_votes: Counter;
export ledger option_c_votes: Counter;
export ledger option_d_votes: Counter;
export ledger min_eligibility_threshold: Uint<32>;

// ── Private witnesses (evaluated locally on the user's device by 1AM Wallet) ─
witness eligibility_score(): Uint<32>;

// ── Circuit 1: Initialize survey ─────────────────────────────────────────────
// All survey parameters are public (disclose explicitly required).
export circuit initialize_survey(
  title_hash: Bytes<32>,
  network_id: Uint<8>,
  threshold: Uint<32>
): [] {
  poll_id.increment(1);
  poll_title_hash = disclose(title_hash);
  active_network_id = disclose(network_id);
  min_eligibility_threshold = disclose(threshold);
}

// ── Circuit 2: Cast zero-knowledge anonymous vote ─────────────────────────────
// The eligibility score is evaluated as a private witness. The choice is
// explicitly disclosed because each public option counter must be updated.
// This is selective disclosure, not a secret-ballot contract.
export circuit cast_anonymous_vote(opt: Uint<8>): [] {
  const score: Uint<32> = eligibility_score();
  const req_threshold: Uint<32> = min_eligibility_threshold;

  assert(score >= req_threshold, "Ineligible: secret score below threshold");
  assert(opt <= 3, "Invalid ballot option");

  const public_opt: Uint<8> = disclose(opt);

  if (public_opt == 0) {
    option_a_votes.increment(1);
  } else if (public_opt == 1) {
    option_b_votes.increment(1);
  } else if (public_opt == 2) {
    option_c_votes.increment(1);
  } else {
    option_d_votes.increment(1);
  }

  total_ballots_cast.increment(1);
}

// ── Circuit 3: Verifiable state disclosure ────────────────────────────────────
export circuit get_public_summary(): Bytes<32> {
  return disclose(poll_title_hash);
}
