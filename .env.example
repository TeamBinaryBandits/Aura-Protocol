# DUST that remains after a transaction estimate. This is a safety buffer, not a fee.
VITE_MIDNIGHT_DUST_BUFFER=30

# Optional read-only indexer configuration. When connected, 1AM's own
# configuration is preferred. Never place a wallet secret or credential here.
VITE_MIDNIGHT_PREVIEW_INDEXER_URI=
VITE_MIDNIGHT_PREVIEW_INDEXER_WS_URI=
VITE_MIDNIGHT_PREPROD_INDEXER_URI=
VITE_MIDNIGHT_PREPROD_INDEXER_WS_URI=

# JSON array of final, on-chain addresses only. Do not put placeholders here.
VITE_AURA_SURVEY_CONTRACTS_JSON=[]
